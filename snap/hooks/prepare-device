#!/bin/sh
set -x
exec >> /var/snap/pi/common/prepare-device.log 2>&1

snapctl set device-service.url="https://XXXXXX:8082/v1/"
snapctl set device-service.headers='{"api-key": "xxxxxx"}'

snapctl set registration.body=""

# ── NOVO: gerar par de chaves de identidade (idempotente) ──────────────
KEY_DIR="/var/snap/pi/common/identity"
PRIV="${KEY_DIR}/hw-id-key.pem"
PUB="${KEY_DIR}/hw-id-key.pub.pem"

mkdir -p "${KEY_DIR}"
chmod 700 "${KEY_DIR}"

if [ ! -f "${PRIV}" ]; then
    openssl genpkey -algorithm EC \
        -pkeyopt ec_paramgen_curve:P-256 \
        -out "${PRIV}"
    chmod 600 "${PRIV}"
    openssl pkey -in "${PRIV}" -pubout -out "${PUB}"
fi
# ─────────────────────────────────────────────────────────────────────

SERIAL=$(grep Serial /proc/cpuinfo | awk '{print $3}')
snapctl set registration.proposed-serial="\"${SERIAL}\""

# ── Exporta a identidade para o content interface "device-identity" ────
# Os snaps confinados (ex. telemetria em strict) não conseguem ler os
# assertions do snapd nem o SNAP_COMMON do gadget. Partilhamos aqui o serial
# proposto e a chave, que o gadget expõe via content slot (ver snapcraft.yaml).
printf '%s\n' "${SERIAL}" > "${KEY_DIR}/serial"
chmod 644 "${KEY_DIR}/serial"